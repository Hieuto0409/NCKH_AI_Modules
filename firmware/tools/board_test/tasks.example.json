{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP32: 1 - Flash AI fixture and test",
      "type": "process",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/python.exe",
      "args": [
        "-X",
        "utf8",
        "${workspaceFolder}/tools/board_test/flash_and_capture.py",
        "--environment",
        "esp32-s3-devkitc-1-fixture",
        "--port",
        "COM6",
        "--seconds",
        "45",
        "--manifest",
        "${workspaceFolder}/../docs/thingsboard-oled/evidence.json",
        "--log-dir",
        "${workspaceFolder}/.pio/verification/thingsboard"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
